# =========================
# Server
# =========================
PORT=8080
NODE_ENV=development

# Comma-separated list of allowed origins (leave empty in dev)
# Example:
# CORS_ORIGINS=https://cars.example.com,https://admin.example.com
CORS_ORIGINS=

# =========================
# Supabase
# =========================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =========================
# Authentication
# =========================
# Used for dealer/admin session tokens
JWT_SECRET=change_this_to_a_long_random_string

# Optional: admin-only API key (if you want a simple admin gate)
ADMIN_API_KEY=change_me_optional

# Admin dashboard login
ADMIN_EMAIL=admin@example.com
# Optional fallback username
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# =========================
# Cloudinary (Media Uploads)
# =========================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Root folder used when uploading dealer media
CLOUDINARY_FOLDER_ROOT=carsales-platform

# =========================
# Stripe (paid dealer tier — $98/mo subscription)
# =========================
# Primary price ID for paid plan checkout (falls back to STRIPE_PRICE_TIER3 if unset)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PAID=
STRIPE_WEBHOOK_SECRET=

# Legacy price IDs (optional; not used by new landing if STRIPE_PRICE_PAID is set)
STRIPE_PRICE_TIER1=
STRIPE_PRICE_TIER2=
STRIPE_PRICE_TIER3=

# =========================
# Free tier lead routing (Our Sales Team inbox / WhatsApp)
# =========================
# E.164 or digits-only number for WhatsApp links on free-tier dealer storefronts
CASH_CLOSERS_WHATSAPP_E164=

# Inbox for new storefront leads and waitlist applications (sales / operations team)
SALES_TEAM_INBOX_EMAIL=

# If "1", also BCC the dealer profile email when a free-tier lead email is sent
BCC_DEALER_ON_FREE_LEADS=0

# =========================
# ACJ Marketplace (optional)
# =========================
# Default reservation deposit % when dealer profile has no reservation_deposit_pct (e.g. 10)
MARKETPLACE_RESERVATION_DEPOSIT_PCT=

# Set to 1 or true to only show acj_quality_verified vehicles on /marketplace
MARKETPLACE_REQUIRE_QUALITY=0

# =========================
# Email (Resend)
# =========================
# Verified sender on your Resend domain, e.g. notifications@yourdomain.com
# or full RFC format: Auto Concierge Jamaica <notifications@yourdomain.com>
EMAIL_FROM=
RESEND_API_KEY=
EMAIL_FROM_NAME=Auto Concierge Jamaica
# Optional reply-to for support / sales
EMAIL_REPLY_TO=
APP_BASE_URL=http://localhost:8080
